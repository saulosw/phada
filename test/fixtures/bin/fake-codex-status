#!/usr/bin/env node
import { appendFileSync } from 'node:fs'

const env = process.env
const argv = process.argv.slice(2)
const mode = env.FAKE_STATUS_MODE ?? 'logged_in'

if (env.FAKE_STATUS_CAPTURE) {
  const captured = { argv, GITHUB_TOKEN: env.GITHUB_TOKEN, GH_TOKEN: env.GH_TOKEN }
  appendFileSync(env.FAKE_STATUS_CAPTURE, `${JSON.stringify(captured)}\n`)
}

if (argv[0] === '--version') {
  if (mode === 'hang') await new Promise((resolve) => setTimeout(resolve, 60_000))
  else process.stdout.write('codex-cli 0.160.0\n')
  process.exit(0)
}

if (argv[0] !== 'login' || argv[1] !== 'status') {
  process.stderr.write(`fake-codex-status: unexpected arguments ${argv.join(' ')}\n`)
  process.exit(64)
}

switch (mode) {
  case 'logged_in':
    process.stderr.write('Logged in using ChatGPT\n')
    break
  case 'api_key':
    process.stderr.write('Logged in using an API key - sk-proj-***ABCDE\n')
    break
  case 'logged_out':
    process.stderr.write('Not logged in\n')
    process.exit(1)
    break
  case 'odd_output':
    process.stderr.write('Welcome to Codex\n')
    break
  case 'crash':
    process.stderr.write('Error: could not read auth.json\n')
    process.exit(2)
    break
  case 'hang':
    await new Promise((resolve) => setTimeout(resolve, 60_000))
    break
  default:
    process.stderr.write(`fake-codex-status: unknown FAKE_STATUS_MODE "${mode}"\n`)
    process.exit(64)
}
