#!/usr/bin/env node
import { existsSync, readdirSync, readFileSync, readlinkSync, writeFileSync } from 'node:fs'
import { join } from 'node:path'

let stdin = ''
for await (const chunk of process.stdin) stdin += chunk

const env = process.env
const argv = process.argv.slice(2)
const instructionsPath = argv[argv.indexOf('--append-system-prompt-file') + 1]
const mcpConfigPath = argv.includes('--mcp-config')
  ? argv[argv.indexOf('--mcp-config') + 1]
  : undefined
if (env.FAKE_CLAUDE_CAPTURE) {
  const captured = {
    argv,
    stdin,
    instructions:
      instructionsPath !== undefined && existsSync(instructionsPath)
        ? readFileSync(instructionsPath, 'utf8')
        : null,
    mcpConfig:
      mcpConfigPath !== undefined && existsSync(mcpConfigPath)
        ? JSON.parse(readFileSync(mcpConfigPath, 'utf8'))
        : null,
    cwd: process.cwd(),
    env: {
      GITHUB_TOKEN: env.GITHUB_TOKEN,
      GH_TOKEN: env.GH_TOKEN,
      PATH: env.PATH,
      GH_CONFIG_DIR: env.GH_CONFIG_DIR,
    },
    plugin: pluginOf(argv),
  }
  writeFileSync(env.FAKE_CLAUDE_CAPTURE, JSON.stringify(captured))
}

function pluginOf(args) {
  const index = args.indexOf('--plugin-dir')
  if (index === -1) return null
  const dir = args[index + 1]
  const manifestPath = join(dir, '.claude-plugin', 'plugin.json')
  const links = {}
  for (const folder of ['skills', 'commands']) {
    if (!existsSync(join(dir, folder))) continue
    for (const entry of readdirSync(join(dir, folder))) {
      try {
        links[`${folder}/${entry}`] = readlinkSync(join(dir, folder, entry))
      } catch {
        links[`${folder}/${entry}`] = null
      }
    }
  }
  return {
    dir,
    manifest: existsSync(manifestPath) ? JSON.parse(readFileSync(manifestPath, 'utf8')) : null,
    links,
  }
}

const secret = env.FAKE_CLAUDE_SECRET ?? ''
const detail = env.FAKE_CLAUDE_DETAIL ?? 'API Error: 500'
const result = (fields) => JSON.stringify({ type: 'result', subtype: 'success', ...fields })
const usage = {
  input_tokens: 12,
  cache_creation_input_tokens: 3000,
  cache_read_input_tokens: 500,
  output_tokens: 420,
}

switch (env.FAKE_CLAUDE_MODE ?? 'success') {
  case 'success':
    process.stdout.write(
      result({
        is_error: false,
        result: 'LGTM from fake',
        modelUsage: { 'claude-fake-1': {} },
        usage,
      }),
    )
    break
  case 'stream': {
    const toolUse = (name) =>
      JSON.stringify({
        type: 'assistant',
        message: {
          content: [
            { type: 'text', text: 'checking' },
            { type: 'tool_use', name, input: {} },
          ],
        },
      })
    process.stdout.write(
      [
        JSON.stringify({ type: 'system', subtype: 'init', tools: [] }),
        toolUse('mcp__phada__read_file'),
        toolUse('mcp__claude_ai_Linear__get_issue'),
        toolUse('mcp__linear__search'),
        JSON.stringify({ type: 'user', message: { content: [{ type: 'tool_result' }] } }),
        result({
          is_error: false,
          result: 'LGTM from fake',
          modelUsage: { 'claude-fake-1': {} },
          usage,
        }),
        '',
      ].join('\n'),
    )
    break
  }
  case 'denials':
    process.stdout.write(
      [
        JSON.stringify({ type: 'system', subtype: 'init', tools: [] }),
        result({
          is_error: false,
          result: 'Found 1 issue.',
          modelUsage: { 'claude-fake-1': {} },
          usage,
          permission_denials: [
            {
              tool_name: 'Bash',
              tool_use_id: 't1',
              tool_input: { command: 'npm test', description: 'Run' },
            },
            {
              tool_name: 'Read',
              tool_use_id: 't2',
              tool_input: { file_path: '/home/u/.ssh/id_rsa' },
            },
            { tool_name: 'Grep', tool_use_id: 't3', tool_input: { pattern: 'x', path: '/etc' } },
            { tool_name: 'WebFetch', tool_use_id: 't4', tool_input: { url: 'https://x' } },
          ],
        }),
        '',
      ].join('\n'),
    )
    break
  case 'garbage_then_result':
    process.stdout.write(
      `not json\n{"type":"system"}\n${result({ is_error: false, result: 'LGTM from fake', usage })}\n`,
    )
    break
  case 'no_model':
    process.stdout.write(result({ is_error: false, result: 'LGTM from fake', usage }))
    break
  case 'no_usage':
    process.stdout.write(
      result({ is_error: false, result: 'LGTM from fake', modelUsage: { 'claude-fake-1': {} } }),
    )
    break
  case 'multi_model':
    process.stdout.write(
      result({
        is_error: false,
        result: 'LGTM from fake',
        modelUsage: {
          'claude-helper-1': { outputTokens: 30 },
          'claude-fake-1': { outputTokens: 420 },
          'claude-other-1': null,
        },
        usage,
      }),
    )
    break
  case 'empty_result':
    process.stdout.write(result({ is_error: false, result: '  \n', usage }))
    break
  case 'echo_stdin_size':
    process.stdout.write(result({ is_error: false, result: String(stdin.length), usage }))
    break
  case 'partial_usage':
    process.stdout.write(
      result({ is_error: false, result: 'LGTM from fake', usage: { output_tokens: 7 } }),
    )
    break
  case 'is_error':
    process.stdout.write(result({ is_error: true, result: `${detail} ${secret}` }))
    process.exitCode = 1
    break
  case 'max_turns':
    process.stdout.write(
      JSON.stringify({
        type: 'result',
        subtype: 'error_max_turns',
        is_error: true,
        errors: ['Reached maximum number of turns (3)'],
        usage,
      }),
    )
    process.exitCode = 1
    break
  case 'logged_out':
    process.stdout.write(result({ is_error: true, result: 'Not logged in · Please run /login' }))
    process.exitCode = 1
    break
  case 'logged_out_stderr':
    process.stderr.write('Invalid API key · Please run /login\n')
    process.exitCode = 1
    break
  case 'usage_limit_stderr':
    process.stderr.write('5-hour limit reached ∙ resets 3pm\n')
    process.exitCode = 1
    break
  case 'exit1':
    process.stderr.write(`boom ${secret}\n`)
    process.exitCode = 1
    break
  case 'exit1_silent':
    process.exitCode = 1
    break
  case 'invalid_json':
    process.stdout.write(`not json ${secret}`)
    break
  case 'crash':
    process.kill(process.pid, 'SIGKILL')
    break
  case 'hang':
    setInterval(() => {}, 1_000)
    break
  default:
    process.stderr.write(`fake-claude: unknown FAKE_CLAUDE_MODE "${env.FAKE_CLAUDE_MODE}"\n`)
    process.exitCode = 99
}
