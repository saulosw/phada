{
  "name": "phada",
  "version": "0.11.0",
  "description": "Review GitHub pull requests with the AI you already use: Claude Code, Codex or Ollama.",
  "keywords": [
    "code-review",
    "pull-request",
    "github",
    "ai",
    "cli",
    "claude-code",
    "codex",
    "ollama"
  ],
  "license": "Apache-2.0",
  "author": "Saulo Pereira Jesus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saulosw/phada.git"
  },
  "bugs": {
    "url": "https://github.com/saulosw/phada/issues"
  },
  "homepage": "https://github.com/saulosw/phada#readme",
  "type": "module",
  "bin": {
    "phada": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json && tsx scripts/copy-grammars.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepack": "npm run build",
    "prepare": "node -e \"require('node:fs').existsSync('.githooks') && require('node:child_process').spawnSync('git', ['config', 'core.hooksPath', '.githooks'])\"",
    "smoke": "tsx scripts/smoke.ts",
    "test": "vitest run",
    "dev": "tsx src/bin.ts",
    "review": "tsx src/bin.ts review",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:unused": "knip"
  },
  "dependencies": {
    "execa": "^10.0.1",
    "ink": "^8.0.0",
    "picomatch": "^4.0.7",
    "react": "^19.3.1",
    "web-tree-sitter": "^0.27.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "knip": "^6.43.0",
    "prettier": "^3.9.8",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
