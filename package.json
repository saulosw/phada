{
  "name": "phada",
  "version": "0.1.0",
  "description": "Review GitHub pull requests with the AI you already use: Claude Code, Codex or Ollama.",
  "keywords": [
    "code-review",
    "pull-request",
    "github",
    "ai",
    "cli",
    "claude-code",
    "codex",
    "ollama"
  ],
  "license": "Apache-2.0",
  "author": "Saulo Pereira Jesus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saulosw/phada.git"
  },
  "bugs": {
    "url": "https://github.com/saulosw/phada/issues"
  },
  "homepage": "https://github.com/saulosw/phada#readme",
  "type": "module",
  "bin": {
    "phada": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepack": "npm run build",
    "smoke": "tsx scripts/smoke.ts",
    "test": "vitest run",
    "dev": "tsx src/bin.ts",
    "review": "tsx src/bin.ts review",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "execa": "^10.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
